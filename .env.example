# --- App ---
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_SITE_URL=https://threadsdl.io

# --- Database (operational analytics/settings only - never stores media) ---
# SQLite for local/small deployments. Swap for a Postgres URL in production if desired.
DATABASE_URL="file:./prisma/dev.db"

# --- Admin dashboard ---
# Required to enable /admin routes. Use a long random string. If unset, admin routes return 503.
ADMIN_PASSWORD=
# Random 32+ char secret used to sign admin session cookies.
ADMIN_SESSION_SECRET=

# --- Rate limiting / abuse prevention ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
FETCH_RATE_LIMIT_WINDOW_MS=3600000
FETCH_RATE_LIMIT_MAX_REQUESTS=25

# --- Analytics (optional, leave blank to disable) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Ads (optional, leave blank to disable) ---
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
