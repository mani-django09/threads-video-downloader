# Copy to `.env` on the VPS (next to docker-compose.yml) and fill in the values.
# `.env` is git-ignored and excluded from the Docker image -- never commit it.

# --- Required ---
# Email for Let's Encrypt expiry notices.
LETSENCRYPT_EMAIL=you@example.com
# Admin dashboard (/admin). Use long random values:  openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://threadsdl.io

# --- Optional: analytics / ads / Search Console (baked in at BUILD time:
#     after changing these run `bash deploy/update.sh`) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# --- Optional: rate limits (defaults shown) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20
FETCH_RATE_LIMIT_WINDOW_MS=3600000
FETCH_RATE_LIMIT_MAX_REQUESTS=25
